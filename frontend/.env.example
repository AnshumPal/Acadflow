# Copy to .env.local to override. All values are optional.

# Backend origin. Leave empty to use the same origin: the Vite dev and preview servers
# proxy /api to FastAPI on http://127.0.0.1:8000, so no CORS setup is needed.
VITE_API_BASE_URL=

# Where lecture logs, syllabus units and the academic calendar are stored:
#   local  = this browser (default, until the backend ships the endpoints)
#   remote = /api/v1/lectures, /api/v1/syllabus, /api/v1/calendar
VITE_DATA_SOURCE=local

# Turn on once the backend supports them (see docs/api-contract-academic-tracking.md).
VITE_RESCHEDULE_TARGET_PERIOD=false
VITE_RESCHEDULE_LAB_BLOCKS=false
